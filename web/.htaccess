# PES 2027 Server Apache & LiteSpeed Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route /version.json to dynamic api/version.php
    RewriteRule ^version\.json$ api/version.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Enable CORS for iOS and Web tools
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, HEAD, OPTIONS"
    Header set Access-Control-Allow-Headers "Range, Content-Type, X-Admin-Key"
    Header set Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
    Header set Accept-Ranges "bytes"
</IfModule>

# Disable Gzip compression on zip archives (ensures HTTP Range streaming works smoothly)
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI \.zip$ no-gzip dont-vary
</IfModule>

# Increase upload limits if PHP module is active
<IfModule mod_php.c>
    php_value upload_max_filesize 5000M
    php_value post_max_size 5000M
    php_value max_execution_time 3600
    php_value max_input_time 3600
</IfModule>
